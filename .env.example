# ============================================================
# isthistrue. / escierto.  —  TODO se configura aqui.
# David: rellena las claves. Vacio + DEBUG=True => modo simulado.
# ============================================================

# --- Django ---
DEBUG=True
SECRET_KEY=cambia-esto-por-una-cadena-larga-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,isthistrue.xyztserver.com,escierto.xyztserver.com,wikitrue.xyztserver.com

# --- Base de datos (contenedor postgres del compose) ---
POSTGRES_DB=isthistrue
POSTGRES_USER=isthistrue
POSTGRES_PASSWORD=cambia-esto
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Anthropic (console.anthropic.com; fija limite mensual = doble airbag) ---
ANTHROPIC_API_KEY=
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_VERDICT=claude-sonnet-4-6
# Modelo para señales de Off-Topic (intercambiable en el futuro):
MODEL_OFFTOPIC=claude-haiku-4-5-20251001
# Clasificador (manipulacion + hecho/opinion) - Sonnet decidido; Haiku si el volumen aprieta:
MODEL_CLASSIFIER=claude-sonnet-4-6
# Reescaneo al 40% de votos (una vez por post, minimo 50 usuarios, pasa por candados):
MODEL_PREMIUM=claude-opus-4-8
# Forzar agentes simulados aunque haya clave (pruebas sin gastar):
MOCK_AGENTS=auto   # auto | true | false

# --- Presupuesto (candados) ---
DAILY_BUDGET_EUR=3.00
MONTHLY_CAP_EUR=100

# --- SearXNG ---
SEARXNG_URL=http://searxng:8080
SEARCHES_PER_CLAIM=3
SEARCHES_PER_CLAIM_AMBIGUOUS=5

# --- Turnstile (Cloudflare; vacio + DEBUG=True => se salta) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (Brevo SMTP; vacio + DEBUG=True => consola) ---
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@xyztserver.com

# --- Alertas de administracion (Telegram DESCARTADO para siempre por David) ---
# Las alertas criticas (caidas, presupuesto, backups) llegaran por email via Brevo:
ADMIN_ALERT_EMAIL=contact@xyztserver.com

# --- Embeddings locales (dedupe semantica; gratis por uso, ~0.5-1.5 GB RAM) ---
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# --- Hugging Face (diarizacion pyannote, Hito 2B) ---
HF_TOKEN=
# --- Espejo de pruebas (staging): true SOLO en /opt/isthistrue-staging ---
STAGING_MODE=false
# --- Hito 2B ---
# Diarizacion: crea cuenta en huggingface.co, acepta condiciones en
# hf.co/pyannote/speaker-diarization-3.1 y hf.co/pyannote/segmentation-3.0,
# Settings -> Access Tokens -> New token (Read) -> pega aqui el hf_...
# (HF_TOKEN ya definido arriba). Vacio = sin diarizacion (todo funciona igual).
OCR_FRAME_INTERVAL=5
# API por lotes de Anthropic (-50% en veredictos). true recomendado en produccion:
USE_BATCH_API=true
# --- Barrido de clasificacion (4.3-A.7) ---
# Un video real trae CIENTOS de frases: si se mandan todas de golpe, la respuesta
# JSON vuelve cortada y se pierden TODAS las señales del semaforo. Se trocea.
# Frases por llamada (baja este numero si ves lotes ilegibles en los logs):
SWEEP_BATCH_SIZE=40
# Techo de la respuesta del modelo en tokens (subelo si los lotes vuelven cortados):
SWEEP_MAX_TOKENS=8000
# --- Umbrales vivos (4.3-A.7) ---
# Estos valores son la FABRICA: siembran la base de datos la primera vez y, con
#   docker compose exec web python manage.py seed_settings --force
# pisan lo que haya. Despues, /panel/settings/ manda en vivo sin tocar el .env.
# Personas que pulsan «Discuto» en una frase antes de que entre Opus:
SEGMENT_OPUS_DOWNVOTES=5
# Frases del MISMO hablante que se leen alrededor para decidir el semaforo:
VERDICT_CONTEXT_BEFORE=1
VERDICT_CONTEXT_AFTER=1
# Resto de umbrales (mismo nombre que en el panel, en MAYUSCULAS):
OPINION_RATIO_PERCENT=70
MINUTES_PER_FACTUAL_CLAIM=5
VOTES_TO_VALIDATE=5
VOTES_TO_RESCUE=10
VALIDATION_WINDOW_DAYS=3
STARTUP_MODE_MIN_USERS=50
TRENDING_VOTES_THRESHOLD=5
TRENDING_WINDOW_DAYS=7
MESSAGE_SENSITIVE_REPORTS=5
# --- Videos largos (4.3-A.8) ---
# Minutos que cualquier usuario puede postear sin que se le pida nada:
ANALYSIS_FREE_MINUTES=20
# Coste estimado de analizar UN minuto de video, en centimos. Fija dos cosas: lo
# que se reserva del deposito diario y la donacion sugerida por el exceso.
# Recalibralo con las cifras reales de la consola de Anthropic.
CENTS_PER_VIDEO_MINUTE=12
# Techo de transcripcion: se analiza el video ENTERO hasta aqui (90 min):
TRANSCRIBE_MAX_SECONDS=5400
# Segundos de espera del pre-chequeo del video al postear (titulo/duracion/+18):
PROBE_TIMEOUT_SECONDS=12
# --- Wiki por personas (4.3-C) ---
# 1 = las fichas /persona/<nombre>/ salen en buscadores. 0 = existen y se pueden
# enlazar, pero con noindex. Por defecto APAGADO (decision de David).
WIKI_INDEX_PEOPLE=0
# --- 4.3-E ---
# Minimo de hablantes identificados (%) para poder marcar un video como factual:
MIN_IDENTIFIED_SPEAKERS_PERCENT=50
# Horas antes de dar un analisis por atascado y relanzarlo solo:
STUCK_ANALYSIS_HOURS=6
# --- 4.3-F ---
# Presupuesto (en euros enteros). El DIARIO no se escribe: sale del mensual
# dividido entre los dias del mes. Se editan tambien desde /panel/settings/.
BUDGET_BASE_EUR=100
BUDGET_HARD_CEILING_EUR=200
# Porcentaje del deposito diario a partir del cual un video espera en cola:
QUEUE_THRESHOLD_PERCENT=50
# --- Superusuario (se crea/actualiza con: manage.py ensure_superuser) ---
ADMIN_EMAIL=contact@xyztserver.com
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-fuerte
# --- Reparto de modelos DEFINITIVO (README §25): moderacion SOLO Haiku (MODEL_CHEAP),
# clasificador y veredictos Sonnet, reescaneo 40% Opus (MODEL_PREMIUM, arriba). ---
# (MODERATION_TRIAGE_MODEL y MODEL_RESCAN eran de la ronda v2 y el codigo NO los usa: retirados 2026-08-05.)
