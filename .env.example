# ============================================================
# isthistrue. / escierto.  —  TODO se configura aqui.
# David: rellena las claves. Vacio + DEBUG=True => modo simulado.
# ============================================================

# --- Django ---
DEBUG=True
SECRET_KEY=cambia-esto-por-una-cadena-larga-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,isthistrue.xyztserver.com,escierto.xyztserver.com,wikitrue.xyztserver.com

# --- Base de datos (contenedor postgres del compose) ---
POSTGRES_DB=isthistrue
POSTGRES_USER=isthistrue
POSTGRES_PASSWORD=cambia-esto
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Anthropic (console.anthropic.com; fija limite mensual = doble airbag) ---
ANTHROPIC_API_KEY=
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_VERDICT=claude-sonnet-4-6
# Modelo para señales de Off-Topic (intercambiable en el futuro):
MODEL_OFFTOPIC=claude-haiku-4-5-20251001
# Forzar agentes simulados aunque haya clave (pruebas sin gastar):
MOCK_AGENTS=auto   # auto | true | false

# --- Presupuesto (candados) ---
DAILY_BUDGET_EUR=2.00
MONTHLY_CAP_EUR=60

# --- SearXNG ---
SEARXNG_URL=http://searxng:8080
SEARCHES_PER_CLAIM=3
SEARCHES_PER_CLAIM_AMBIGUOUS=5

# --- Turnstile (Cloudflare; vacio + DEBUG=True => se salta) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (Brevo SMTP; vacio + DEBUG=True => consola) ---
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@xyztserver.com

# --- Alertas de administracion (Telegram DESCARTADO para siempre por David) ---
# Las alertas criticas (caidas, presupuesto, backups) llegaran por email via Brevo:
ADMIN_ALERT_EMAIL=contact@xyztserver.com

# --- Embeddings locales (dedupe semantica; gratis por uso, ~0.5-1.5 GB RAM) ---
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# --- Hugging Face (diarizacion pyannote, Hito 2B) ---
HF_TOKEN=
# --- Espejo de pruebas (staging): true SOLO en /opt/isthistrue-staging ---
STAGING_MODE=false
# --- Hito 2B ---
# Diarizacion: crea cuenta en huggingface.co, acepta condiciones en
# hf.co/pyannote/speaker-diarization-3.1 y hf.co/pyannote/segmentation-3.0,
# Settings -> Access Tokens -> New token (Read) -> pega aqui el hf_...
# (HF_TOKEN ya definido arriba). Vacio = sin diarizacion (todo funciona igual).
OCR_FRAME_INTERVAL=5
# API por lotes de Anthropic (-50% en veredictos). true recomendado en produccion:
USE_BATCH_API=true
