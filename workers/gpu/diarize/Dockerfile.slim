# syntax=docker/dockerfile:1
# Variante ADELGAZADA (operador, 2026-08-26): la p4 sobre base runpod -devel pesa
# 21 GB y los centros de datos con enlace flojo al registro tardan >1 h en bajarla.
# La base runtime oficial de PyTorch (torch 2.8 + CUDA 12.8 + cuDNN) pesa la mitad
# y sirve exactamente igual para inferencia. Mismos modelos, mismo handler.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir "runpod>=1.7,<2" "pyannote.audio>=4,<5"

# 5.23-A (leccion del 2026-09-08): el token de Hugging Face entraba como ARG y
# quedaba GRABADO en el historial de la imagen — publica en ghcr, legible por
# cualquiera sin autenticarse. Un secreto de BuildKit se monta solo durante
# esta instruccion y no deja rastro en ninguna capa. Construccion:
#   DOCKER_BUILDKIT=1 docker build --secret id=hf_token,env=HF_TOKEN \
#       -f Dockerfile.slim -t ghcr.io/nulltimed/istt-diarize:<tag> .
RUN --mount=type=secret,id=hf_token \
    HF_TOKEN="$(cat /run/secrets/hf_token)" python -c "import os; from pyannote.audio import Pipeline; \
t=os.environ['HF_TOKEN']; \
Pipeline.from_pretrained('pyannote/speaker-diarization-community-1', token=t); \
Pipeline.from_pretrained('pyannote/speaker-diarization-3.1', token=t)"

# Fix del operador (2026-08-26): en los hosts de Runpod (~128 nucleos) numpy/
# OpenBLAS intenta desplegar hilos que el cgroup del contenedor no concede y
# numpy.linalg.inv (setup PLDA de pyannote 4) se queda girando PARA SIEMPRE sin
# error. Cazado con faulthandler. En el VPS (8 nucleos) jamas se manifesto.
ENV OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4

COPY handler.py .
RUN python -c "import pyannote.audio, torch, runpod; print('pyannote', pyannote.audio.__version__, 'torch', torch.__version__)"
CMD ["python", "-u", "handler.py"]
